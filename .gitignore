# ASP.NET Core / Visual Studio
## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
.vscode/

# Visual Studio Code
.vscode/

# MSBuild output
*.log
*.pidb
*.psess
*.sap
*.sdf
*.tmp
*.tmp_proj
*.userprefs
*.wrn
*.~vs

# Database files
*.mdf
*.ldf
*.ndf

# Entity Framework Migration files
**/Migrations/*.Designer.cs
**/Migrations/*.sql
!**/Migrations/*.cs

# NuGet Packages
*.nupkg
*.snupkg
packages/
!packages/repositories.config

# WebPublish
WebPublish/
wwwroot/lib/
wwwroot/dist/

# Node.js / Vue.js dependencies
node_modules/
npm-debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Vue.js build output
dist/
dist-ssr/
*.local

# Environment variables
.env
.env.local
.env.*.local
.env.production
.env.development

# IDE files
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# Publish profiles
*.pubxml
*.pubxml.user

# Azure Functions
local.settings.json
*.local.settings.json

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Coverage report
coverage/
*.lcov

# Logs
logs/
*.log
*.htm
*.html

# Temp files
temp/
tmp/
*.tmp
*.dump
*.backup

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# JetBrains Rider
.idea/
*.sln.iml

# Code coverage
*.coverage
*.coveragexml

# Publish
*.pubxml
*.publishproj

# Benchmark results
BenchmarkDotNet.Artifacts/

# Database
*.db
*.sqlite
*.sqlite3

# Connection strings
secrets.json
CommutePro.Server/appsettings.json
appsettings.Development.json
appsettings.Local.json

# Compiled Output
*.dll
*.exe
*.exe.config
*.pdb

# Optional: If you're using Vue CLI and want to ignore cache
.cache/
.parcel-cache/

# Optional: If you're using TypeScript
*.tsbuildinfo

# Optional: If you're using ESLint
.eslintcache

# Ignore large data files
*.csv
**/Data/GTFS/*.txt
**/Data/ML/*.csv
**/logs/*.log

# Don't ignore model files
!**/Models/*.zip